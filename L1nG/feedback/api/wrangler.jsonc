{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "l1ng-feedback-api",
  "main": "worker.js",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://realdate.by-l1ng.com,https://genealogy-tool.by-l1ng.com",
    "TURNSTILE_HOSTNAMES": "realdate.by-l1ng.com,genealogy-tool.by-l1ng.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "l1ng-feedback-db",
      "database_id": "41982056-0458-490b-b9a7-a09f929960e3"
    }
  ],
  "send_email": [{ "name": "FEEDBACK_EMAIL" }],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "l1ng-feedback-attachments"
    }
  ]
}
