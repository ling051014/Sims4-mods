{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "l1ng-feedback-api",
  "main": "worker.js",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://realdate.by-l1ng.com,https://genealogy.by-l1ng.com",
    "TURNSTILE_HOSTNAMES": "realdate.by-l1ng.com,genealogy.by-l1ng.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "l1ng-feedback-db",
      "database_id": "REPLACE_WITH_ACTUAL_D1_DATABASE_ID"
    }
  ]
}
