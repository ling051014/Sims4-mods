{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "l1ng-feedback-api",
  "main": "worker.js",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://realdate.by-l1ng.com,https://genealogy.by-l1ng.com,https://l1ng-realdate.pages.dev,https://l1ng-genealogy-tool.pages.dev",
    "TURNSTILE_HOSTNAMES": "realdate.by-l1ng.com,genealogy.by-l1ng.com,l1ng-realdate.pages.dev,l1ng-genealogy-tool.pages.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "l1ng-feedback-db",
      "database_id": "41982056-0458-490b-b9a7-a09f929960e3"
    }
  ]
}
