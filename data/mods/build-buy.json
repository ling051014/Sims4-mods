    {
      "id": "build-buy-001",
      "order": 1,
      "template": "<div class=\"mod-card\">\n                <div class=\"preview-img\">{{previewHtml}}</div>\n                <div class=\"content\">\n                    <h2 class=\"mod-header\">{{titleHtml}}</h2>\n                    <div class=\"author\">{{authorHtml}}</div>\n                    <div class=\"details\">{{detailsHtml}}</div>\n                    <div class=\"tips\">{{tipsHtml}}</div>\n                </div>\n            </div>",
      "slots": {
        "previewHtml": "<img src=\"preview/build/B.B.B..jpg\">",
        "titleHtml": "Better BuildBuy (B.B.B.)<br>更好的建造購買",
        "authorHtml": "by <a href=\"https://www.patreon.com/TwistedMexi\" target=\"_blank\">TwistedMexi</a>\n                        <br>\n                        <a href=\"https://www.abonnie.uk/\" target=\"_blank\">邦妮个站</a>\n                    ",
        "detailsHtml": "\n                        <div class=\"info-row\"><strong>模組主體 ｜</strong><a href=\"https://www.patreon.com/posts/better-buildbuy-135871452\" target=\"_blank\">TwistedMexi's Better BuildBuy v4.5 Official.zip</a></div>\n                        <div class=\"info-row\"><strong>漢化版本 ｜</strong><a href=\"https://www.abonnie.uk/better-buildbuy\" target=\"_blank\">!tmex-BetterBuildBuy_CHT_CHS_ABonnie.package</a></div>\n                        <div class=\"info-row\"><strong>備用載點 ｜</strong><a href=\"https://www.curseforge.com/sims4/mods/better-buildbuy-organized-debug\" target=\"_blank\">curseforge</a></div>\n                        <div class=\"info-row\"><strong>下載版本 ｜</strong>v4.5</div>\n                        <div class=\"info-row\"><strong>下載日期 ｜</strong>2026.05.19</div>\n                    ",
        "tipsHtml": "\n                        解壓縮後將「Tmex-BetterBuildBuy」資料夾放進Mods即可<br>\n                        <span class=\"text-red\">不要</span>放「TwistedMexi’s Better BuildBuy vX.X.X Official」<br>\n                        <br>\n                        <span class=\"text-red\">只需在安裝時輸入解鎖密技，安裝後無需多次輸入。</span><br>\n                        testingcheats true 開啟大密技<br>\n                        bb.showhiddenobjects 解鎖隱藏物品<br>\n                        bb.showliveeditobjects 解鎖環境物品 (debug)<br>\n                        <br>\n                        <span class=\"text-red\">B.B.B.包含以下模組功能，請務必刪除</span><br>\n                        「BuildMode FreeCam」<br>\n                        「Expandable BuildBuy Catalog」<br>\n                        <br>\n                        🔰 進入建造模式，點擊篩選並勾選<br>\n                        「有組織的調試 / Debug物品分類功能」<br>\n                        勾選後會彈出提示視窗，重啟遊戲即可生效<br>\n                        <br>\n                        ⚠️ 上傳NOCC房屋到工坊前需先取消勾選<br>\n                        「有組織的調試 / Debug物品分類功能」<br>\n                        重啟遊戲後再上傳<br>\n                        <br>\n                        B.B.B.默認隱藏CC家具，需要手動開啟「自訂內容」<br>\n                        <br>\n                        ⌨️ <span class=\"text-purple\"><strong>相關快捷鍵</strong></span><br>\n                        擴展CC家具欄位 <kbd class=\"shortcut-key\">1</kbd> / <kbd class=\"shortcut-key\">~</kbd><br>\n                        自由視角 <kbd class=\"shortcut-key\">Tab</kbd><br>\n                        自由調整燈光顏色 <kbd class=\"shortcut-key\">Shift</kbd> + <span class=\"mouse-hint mouse-left\" role=\"img\" aria-label=\"左鍵\"><span class=\"mouse-hint-wheel\"></span></span> 點擊燈具<br>\n                        將家具加入最愛 <span class=\"mouse-hint mouse-wheel\" role=\"img\" aria-label=\"滑鼠滾輪\"><span class=\"mouse-hint-wheel\"></span></span> 按下滾輪<br>\n                    "
      }
    },
    {
      "id": "build-buy-002",
      "order": 2,
      "template": "<div class=\"mod-card\">\n                <div class=\"preview-img\">{{previewHtml}}</div>\n                <div class=\"content\">\n                    <h2 class=\"mod-header\">{{titleHtml}}</h2>\n                    <div class=\"author\">{{authorHtml}}</div>\n                    <div class=\"details\">{{detailsHtml}}</div>\n                    <div class=\"tips\">{{tipsHtml}}</div>\n                </div>\n            </div>",
      "slots": {
        "previewHtml": "<img src=\"preview/build/T.O.O.L..png\">",
        "titleHtml": "T.O.O.L.<br>自由建造工具",
        "authorHtml": "by <a href=\"https://www.patreon.com/TwistedMexi\" target=\"_blank\">TwistedMexi</a>\n                        <br>\n                        <a href=\"https://www.abonnie.uk/\" target=\"_blank\">邦妮个站</a>\n                    ",
        "detailsHtml": "\n                        <div class=\"info-row\"><strong>模組主體 ｜</strong><a href=\"https://www.patreon.com/posts/144306626\" target=\"_blank\">TwistedMexi's TOOL v3.2 Official.zip</a></div>\n                        <div class=\"info-row\"><strong>漢化版本 ｜</strong><a href=\"https://www.abonnie.uk/tool\" target=\"_blank\">!Tmex-TOOL_CHT_CHS_ABonnie.package</a></div>\n                        <div class=\"info-row\"><strong>備用載點 ｜</strong><a href=\"https://www.curseforge.com/sims4/mods/t-o-o-l\" target=\"_blank\">curseforge</a></div>\n                        <div class=\"info-row\"><strong>下載版本 ｜</strong>v3.2</div>\n                        <div class=\"info-row\"><strong>下載日期 ｜</strong>2026.05.19</div>\n                    ",
        "tipsHtml": "\n                        <span class=\"text-red\">無法單獨使用，需同時安裝B.B.B.</span><br>\n                        <br>\n                        解壓縮後將「Tmex-TOOL」資料夾放進Mods即可<br>\n                        <span class=\"text-red\">不要</span>放「TwistedMexi’s TOOL vX.X Official」<br>\n                        <br>\n                        ⚙️ <span class=\"text-bluegray\"><strong>關閉捕捉地形</strong></span><br>\n                        「選項」>「更改所選設置」>「捕捉地形」<br>\n                        <span class=\"text-yellow\">否則移動物品時，物品會莫名的消失 / 下降</span><br>\n                        <br>\n                        ⌨️ <span class=\"text-purple\"><strong>開啟T.O.O.L.選單快捷鍵</strong></span><br>\n                        生活模式 <kbd class=\"shortcut-key\">Shift</kbd> + <span class=\"mouse-hint mouse-left\" role=\"img\" aria-label=\"左鍵\"><span class=\"mouse-hint-wheel\"></span></span> 點擊指定物品<br>\n                        建造模式 <kbd class=\"shortcut-key\">Shift</kbd> + <kbd class=\"shortcut-key\">T</kbd><br>\n                        <br>\n                        ⌨️ <span class=\"text-purple\"><strong>物品多選快捷鍵</strong></span><br>\n                        1. 長按 <kbd class=\"shortcut-key\">Alt</kbd> + <span class=\"mouse-hint mouse-left\" role=\"img\" aria-label=\"左鍵\"><span class=\"mouse-hint-wheel\"></span></span> 點擊指定物品<br>\n                        2. 長按 <kbd class=\"shortcut-key\">Shift</kbd> + <span class=\"mouse-hint mouse-left\" role=\"img\" aria-label=\"左鍵\"><span class=\"mouse-hint-wheel\"></span></span> 點擊選取範圍 (收尾需點擊第一個圖示下方)<br>\n                        <br>\n                        ⌨️ <span class=\"text-purple\"><strong>其他常用快捷鍵</strong></span><br>\n                        縮小物品 <kbd class=\"shortcut-key\">[</kbd><br>\n                        放大物品 <kbd class=\"shortcut-key\">]</kbd><br>\n                        復原 <kbd class=\"shortcut-key\">Ctrl</kbd> + <kbd class=\"shortcut-key\">Z</kbd> (上一步）<br>\n                        重做 <kbd class=\"shortcut-key\">Ctrl</kbd> + <kbd class=\"shortcut-key\">Y</kbd> (下一步）<br>\n                    "
      }
    },
