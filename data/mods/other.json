    {
      "id": "other-001",
      "order": 1,
      "template": "<div class=\"mod-card\">\n                <div class=\"preview-img\">{{previewHtml}}</div>\n                <div class=\"content\">\n                    <h2 class=\"mod-header\">{{titleHtml}}</h2>\n                    <div class=\"author\">{{authorHtml}}</div>\n                    <div class=\"details\">{{detailsHtml}}</div>\n                    <div class=\"tips\">{{tipsHtml}}</div>\n                </div>\n            </div>",
      "slots": {
        "previewHtml": "<img src=\"preview/other/moonglow.jpg\">",
        "titleHtml": "世界照明",
        "authorHtml": "by <a href=\"https://softerhaze.tumblr.com/tagged/z\" target=\"_blank\">softerhaze.itch",
        "detailsHtml": "\n                        <div class=\"info-row\"><strong>模組主體 ｜</strong><a href=\"https://softerhaze.itch.io/sunblind\" target=\"_blank\">softerhaze - sunblind - royalty and legacy.zip</a></div>\n                        <div class=\"info-row\"><strong>備用載點 ｜</strong>無</div>\n                        <div class=\"info-row\"><strong>下載版本 ｜</strong>Feb 13, 2026</div>\n                        <div class=\"info-row\"><strong>下載日期 ｜</strong>2026.07.05</div>\n                    ",
        "tipsHtml": "\n                        <span class=\"text-green\">目前使用的是Sunblind，但部分環境太暗看不清楚</span></br>\n                        ( <a href=\"https://www.tumblr.com/softerhaze/628014593783087104/added-moonglow-lighting-mod-files-for-every\" target=\"_blank\">Moonglow</a>為備選方案 )</br>\n                        </br>\n                        <span class=\"text-orange\">每次遊戲更新或修復後需重新安裝</span></br>\n                        </br>\n                        請將Data、Delta資料夾「複製」、「貼上」至以下路徑</br>\n                        並選擇「取代」，<span class=\"text-red\">請勿刪除後再貼上</span></br>\n                        ➤ <strong>Origin</strong></br>\n                        C:\\Program Files (x86)\\Origin Games\\The Sims 4</br>\n                        ➤ <strong>Steam</strong></br>\n                        C:\\Program Files (x86)\\Steam\\steamapps\\common\\The Sims 4</br>\n                        ➤ <strong>EA</strong></br>\n                        C:\\Program Files\\EA Games\\The Sims 4</br>\n                        </br>\n                        ➤ <strong>Mac</strong></br>\n                        The Sims 4.app > Contents > res</br>\n                        Mac用戶需參考作者的下載指南</br>\n                    "
      }
    },
    {
      "id": "other-002",
      "order": 2,
      "template": "<div class=\"mod-card\">\n                <div class=\"preview-img\">{{previewHtml}}</div>\n                <div class=\"content\">\n                    <h2 class=\"mod-header\">{{titleHtml}}</h2>\n                    <div class=\"author\">{{authorHtml}}</div>\n                    <div class=\"details\">{{detailsHtml}}</div>\n                    <div class=\"tips\">{{tipsHtml}}</div>\n                </div>\n            </div>",
      "slots": {
        "previewHtml": "<img src=\"preview/other/Better_Graphics.jpg\">",
        "titleHtml": "高清模組",
        "authorHtml": "by <a href=\"https://www.patreon.com/cw/SulSulDUCK\" target=\"_blank\">鴨呀 (SulSulDUCK)</a>",
        "detailsHtml": "\n                        <div class=\"info-row\"><strong>檔案名稱 ｜</strong><a href=\"https://www.patreon.com/posts/better-graphics-113529819\" target=\"_blank\">Better Graphics Solution.zip</a></div>\n                        <div class=\"info-row\"><strong>備用載點 ｜</strong>無</div>\n                        <div class=\"info-row\"><strong>下載版本 ｜</strong>May 31, 2025</div>\n                        <div class=\"info-row\"><strong>下載日期 ｜</strong>2026.07.05</div>\n                    ",
        "tipsHtml": "\n                        <span class=\"text-green\">支援 DX9 與 DX11</span></br>\n                    \n                        請勿將此檔案放入「ConfigOverride」資料夾</br>\n                        否則遊戲無法啟動 (與 <a href=\"https://www.patreon.com/posts/55891224\" target=\"_blank\">Simp4Sims</a> 的版本不同)</br>\n                        必須「取代」Bin 資料夾內的檔案</br>\n                        </br>\n                        需確保 ConfigOverride 資料夾為空</br>\n                        ⤷ 舊文件可能會覆蓋目前文件並導致衝突</br>\n                        </br>\n                        ReShade / GShade 使用者</br>\n                        需要在「…」>「遊戲選項」>「畫面」>關閉「邊緣平滑」</br>\n                        改用 FXAA 或 SMAA</br>\n                        ⤷ 確保 MXAO、DOF、AdaptiveFog 和 DepthHaze 等著色器正常運作</br>\n                        </br>\n                        <span class=\"text-orange\">每次遊戲更新或修復後需重新安裝</span></br>\n                        ⤷ 每次遊戲更新或修復後，GraphicsRules.sgr 檔案都會重置</br>\n                    "
      }
    },
    {
      "id": "other-003",
      "order": 3,
      "template": "<div class=\"mod-card\">\n                <div class=\"preview-img\">{{previewHtml}}</div>\n                <div class=\"content\">\n                    <h2 class=\"mod-header\">{{titleHtml}}</h2>\n                    <div class=\"author\">{{authorHtml}}</div>\n                    <div class=\"details\">{{detailsHtml}}</div>\n                    <div class=\"tips\">{{tipsHtml}}</div>\n                </div>\n            </div>",
      "slots": {
        "previewHtml": "<img src=\"preview/other/reshade.jpg\">",
        "titleHtml": "ReShade",
        "authorHtml": "by RESHADE TEAM",
        "detailsHtml": "\n                        <div class=\"info-row\"><strong>檔案主體 ｜</strong><a href=\"https://reshade.me/\" target=\"_blank\">ReShade with full add-on support</a></div>\n                        <div class=\"info-row\"><strong>漢化版本 ｜</strong>內建繁中</div>\n                        <div class=\"info-row\"><strong>下載版本 ｜</strong>6.7.3</div>\n                        <div class=\"info-row\"><strong>下載日期 ｜</strong>2026.05.18</div>\n                    ",
        "tipsHtml": "\n                        <span class=\"text-red\">支援插件需安裝「Full add-on support」版本</span></br>\n                        濾鏡開關快捷鍵「數字 . 」</br>\n                        濾鏡選單HOME鍵「數字 7 」</br>\n                        </br>\n                        濾鏡資料夾路徑</br>\n                        ∞ <strong>Steam</strong> : 遊戲Sims ⇨ 右鍵內容 ⇨ 已安裝檔案 ⇨ 瀏覽 ⇨ Game ⇨ Bin</br>\n                        ∞ <strong>EA</strong> : 模擬市民4 ⇨ 點右上「…」⇨ 查看屬性 ⇨ 開啟資料夾 ⇨ Game ⇨ Bin</br>\n                        </br>\n                        <span class=\"text-green\">濾鏡核心檔案</span></br>\n                        d3d9.dll（DX9 使用者）</br>\n                        dxgi.dll（X11 使用者）\n                    "
      }
    },
    {
