      "slots": {
        "previewHtml": "<img src=\"preview/other/.jpg\">",
        "titleHtml": "SRWE 高清截圖",
        "authorHtml": "by <a href=\"https://github.com/dtgDTGdtg\" target=\"_blank\">dtgDTGdtg</a>",
        "detailsHtml": "\n                        <div class=\"info-row\"><strong>模組主體 ｜</strong><a href=\"https://github.com/dtgDTGdtg/SRWE/releases\" target=\"_blank\">SRWE v2.3.6</a></div>\n                        <div class=\"info-row\"><strong>漢化版本 ｜</strong>無吳</div>\n                        <div class=\"info-row\"><strong>下載版本 ｜</strong>v2.3.6</div>\n                        <div class=\"info-row\"><strong>下載日期 ｜</strong>2026.05.10</div>\n                    ",
        "tipsHtml": "\n                        需要在「…」>「遊戲選項」>「畫面」中</br>\n                        將顯示模式切換為「視窗模式」</br>\n                        </br>\n                        打開 SRWE 點擊左上角選擇「 TS4_x64.exe」</br>\n                        輸入寬度高度參數，數值越大越高清也越佔空間</br>\n                        </br>\n                        若有安裝濾鏡 ( ReShade / GShade ) 使用一樣的截圖快捷鍵</br>\n                        沒有按裝濾鏡則使用遊戲內建快捷鍵「 C 」</br>\n                        </br>\n                        截圖後回到 SRWE 點擊「 Taskbar mode 」恢復遊戲大小</br>\n                    "
      }
    },
