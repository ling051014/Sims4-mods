      "slots": {
        "previewHtml": "<img src=\"preview/other/hide_ui.webp\">",
        "titleHtml": "隱藏UI介面",
        "authorHtml": "by <a href=\"https://www.patreon.com/vyxated\" target=\"_blank\">VYXATED</a>",
        "detailsHtml": "\n                        <div class=\"info-row\"><strong>插件主體 ｜</strong><a href=\"https://github.com/FransBouma/ShaderToggler/releases\" target=\"_blank\">ShaderToggler_v121.zip</a> (64位元)</div>\n                        <div class=\"info-row\"><strong>其他檔案 ｜</strong><a href=\"https://www.patreon.com/posts/reshade-hide-ui-93652879\" target=\"_blank\">ShaderToggler_DX11.ini</a> (DX11)</div>\n                        <div class=\"info-row\"><strong>下載版本 ｜</strong>v121</div>\n                        <div class=\"info-row\"><strong>下載日期 ｜</strong>2026.05.18</div>\n                    ",
        "tipsHtml": "\n                        <span class=\"text-green\">支援 ReShade 與 GShade</span></br>\n                        <span class=\"text-red\">ReShade with full add-on support 需 5.1以上版本</span></br>\n                        </br>\n                        32位元下載 ⇨ ShaderToggler_x86_101.zip</br>\n                        DX9下載 ⇨ ShaderToggler.ini</br>\n                        </br>\n                        <span class=\"text-red\">ini 檔案應該命名為 ShaderToggler.ini</span></br>\n                        <span class=\"text-red\">下載 DX11 版本需刪除「_DX11」後綴</span></br>\n                        </br>\n                        請「剪下」、「貼上」至資料夾路徑</br>\n                        ∞ <strong>Steam</strong> : 遊戲Sims ⇨ 右鍵內容 ⇨ 已安裝檔案 ⇨ 瀏覽 ⇨ Game ⇨ Bin</br>\n                        ∞ <strong>EA</strong> : 模擬市民4 ⇨ 點右上「…」⇨ 查看屬性 ⇨ 開啟資料夾 ⇨ Game ⇨ Bin</br>\n                    "
      }
    },
    {
