        "authorHtml": "by <a href=\"https://sims4studio.com/\" target=\"_blank\">Sims 4 Studio</a>",
        "detailsHtml": "\n                        <div class=\"info-row\"><strong>程式主體 ｜</strong><a href=\"https://sims4studio.com/thread/29786/sims-studio-windows-star-open\" target=\"_blank\">InstallSims4Studio_v3.2.6.3 (Star).exe</a></div>\n                        <div class=\"info-row\"><strong>漢化版本 ｜</strong>內建繁中</div>\n                        <div class=\"info-row\"><strong>下載版本 ｜</strong>v3.2.6.3</div>\n                        <div class=\"info-row\"><strong>下載日期 ｜</strong>2026.06.03</div>\n                    ",
