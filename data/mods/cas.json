      "template": "<div class=\"mod-card\">\n                <div class=\"preview-img\">{{previewHtml}}</div>\n                <div class=\"content\">\n                    <h2 class=\"mod-header\">{{titleHtml}}</h2>\n                    <div class=\"author\">{{authorHtml}}</div>\n                    <div class=\"details\">{{detailsHtml}}</div>\n                    <div class=\"tips\">{{tipsHtml}}</div>\n                </div>\n            </div>",
      "slots": {
        "previewHtml": "<img src=\"preview/cas/LifetimeAspirationsReworked.jpg\">",
        "titleHtml": "Lifetime Aspirations Reworked<br>抱負大修",
        "authorHtml": "by <a href=\"https://www.patreon.com/cw/NeedCoffee4That\" target=\"_blank\">NeedCoffee4That</a>\n                        <br>\n                        <a href=\"https://www.patreon.com/cw/ling051014\" target=\"_blank\">L1nG</a> (我)\n                    ",
        "detailsHtml": "\n                        <div class=\"info-row\"><strong>模組主體 ｜</strong><a href=\"https://www.patreon.com/NeedCoffee4That/posts/lifetime-89276756\" target=\"_blank\">NC4T_LifetimeAspirationsReworked.zip</a></div>\n                        <div class=\"info-row\"><strong>漢化版本 ｜</strong><a href=\"https://translations.by-l1ng.com/#translation-lifetime-aspirations\" target=\"_blank\">!_L1nG_NC4T_LifetimeAspirationsReworked_CHT_BY_L1nG.package</a></div>\n                        <div class=\"info-row\"><strong>備用載點 ｜</strong>無</div>\n                        <div class=\"info-row\"><strong>所需DLC ｜</strong>無</div>\n                        <div class=\"info-row\"><strong>下載版本 ｜</strong>May 1, 2026</div>\n                        <div class=\"info-row\"><strong>下載日期 ｜</strong>2026.10.19</div>\n                    ",
        "tipsHtml": "\n            重製原版抱負為單一長期目標，並新增兒童、老年及幽靈等專屬抱負。<br>\n            <br>\n            <span class=\"text-red\">請依照已購買的 DLC 選擇檔案，未擁有的資料片對應檔案不可安裝。</span><br>\n            <span class=\"text-orange\">與舊版 ky-e v0.5 不可混用；更換前先備份存檔及抱負進度。</span><br>\n            <br>\n            <span class=\"text-green\">目前依 DLC 建議保留 33 個檔案，另外 1 個腳本可選用。</span><br>\n            <details class=\"warning-accordion\">\n                <summary class=\"warning-toggle-btn\"><span class=\"text-green\">目前 DLC 可安裝的檔案 (33 個)</span></summary>\n                <div class=\"warning-content\">\n                    <span class=\"text-purple\">01 Lifetime Aspirations / 原版終生抱負重製</span><br>\n                    <span class=\"text-orange\">!Lifetime Aspirations KIDS</span><br>\n                    NC4T_<wbr>LifetimeAspirationsReworked_<wbr>KIDS_<wbr>BG_<wbr>BaseGame.package<br>\n                    ⤷ 遊戲本體即可使用<br>\n                    <span class=\"text-orange\">!Lifetime Aspirations TEENS</span><br>\n                    NC4T_<wbr>LifetimeAspirationsReworked_<wbr>TEENS_<wbr>EP12_<wbr>HighSchoolYears.package<br>\n                    ⤷ 需要 EP12《高中歲月》<br>\n                    NC4T_<wbr>LifetimeAspirationsReworked_<wbr>BG.package<br>\n                    ⤷ 遊戲本體即可使用<br>\n                    NC4T_<wbr>LifetimeAspirationsReworked_<wbr>EP03_<wbr>CityLiving.package<br>\n                    ⤷ 需要 EP03《都會生活》<br>\n                    NC4T_<wbr>LifetimeAspirationsReworked_<wbr>EP04_<wbr>Cats&amp;Dogs.package<br>\n                    ⤷ 需要 EP04《貓狗總動員》<br>\n                    NC4T_<wbr>LifetimeAspirationsReworked_<wbr>EP07_<wbr>IslandLiving.package<br>\n                    ⤷ 需要 EP07《島嶼生活》<br>\n                    NC4T_<wbr>LifetimeAspirationsReworked_<wbr>EP10_<wbr>SnowyEscape.package<br>\n                    ⤷ 需要 EP10《雪國勝地》<br>\n                    NC4T_<wbr>LifetimeAspirationsReworked_<wbr>EP15_<wbr>ForRent.package<br>\n                    ⤷ 需要 EP15《出租住宅》<br>\n                    NC4T_<wbr>LifetimeAspirationsReworked_<wbr>EP18_<wbr>B&amp;H.package<br>\n                    ⤷ 需要 EP18《事業與嗜好》<br>\n                    NC4T_<wbr>LifetimeAspirationsReworked_<wbr>EP21_<wbr>RoyaltyLegacy.package<br>\n                    ⤷ 需要 EP21《王室與傳承》<br>\n                    NC4T_<wbr>LifetimeAspirationsReworked_<wbr>GP02_<wbr>SpaDay.package<br>\n                    ⤷ 需要 GP02《一日水療》<br>\n                    NC4T_<wbr>LifetimeAspirationsReworked_<wbr>GP04_<wbr>Vampires.package<br>\n                    ⤷ 需要 GP04《吸血鬼》<br>\n                    NC4T_<wbr>LifetimeAspirationsReworked_<wbr>SP46_<wbr>HomeChefHustle.package<br>\n                    ⤷ 需要 SP46《居家主廚》<br>\n                    NC4T_<wbr>LifetimeAspirationsReworked_<wbr>SP49_<wbr>CrystalCreations.package<br>\n                    ⤷ 需要 SP49《水晶創意》<br>\n                    <br>\n                    <span class=\"text-purple\">02 New Aspirations / 新增終生抱負</span><br>\n                    <span class=\"text-orange\">!New Aspirations KIDS</span><br>\n                    NC4T_<wbr>NewAspirations_<wbr>KIDS_<wbr>BG_<wbr>BaseGame.package<br>\n                    ⤷ 遊戲本體即可使用<br>\n                    NC4T_<wbr>NewAspirations_<wbr>KIDS_<wbr>EP05_<wbr>Seasons.package<br>\n                    ⤷ 需要 EP05《春夏秋冬》<br>\n                    NC4T_<wbr>NewAspirations_<wbr>BG_<wbr>BaseGame.package<br>\n                    ⤷ 遊戲本體即可使用<br>\n                    NC4T_<wbr>NewAspirations_<wbr>EP01_<wbr>GetToWork.package<br>\n                    ⤷ 需要 EP01《來去上班》<br>\n                    NC4T_<wbr>NewAspirations_<wbr>EP03_<wbr>CityLiving.package<br>\n                    ⤷ 需要 EP03《都會生活》<br>\n                    NC4T_<wbr>NewAspirations_<wbr>EP04_<wbr>CatsAndDogs.package<br>\n                    ⤷ 需要 EP04《貓狗總動員》<br>\n                    NC4T_<wbr>NewAspirations_<wbr>EP05_<wbr>Seasons.package<br>\n                    ⤷ 需要 EP05《春夏秋冬》<br>\n                    NC4T_<wbr>NewAspirations_<wbr>EP07_<wbr>IslandLiving.package<br>\n                    ⤷ 需要 EP07《島嶼生活》<br>\n                   